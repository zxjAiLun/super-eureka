# ChessArena worker service (section 19).
#
# The worker owns the scheduler and spawns cutechess-cli subprocesses.  On
# stop it must:
#   1. stop accepting new pairs,
#   2. SIGTERM the cutechess process group,
#   3. wait up to 15s, then SIGKILL,
#   4. mark the current attempt INTERRUPTED (not scored).
#
# KillMode=mixed sends SIGTERM to the main process (the worker's handler then
# terminates its cutechess children gracefully) and, if the worker dies
# abnormally (OOM/crash/SIGKILL), systemd still kills the whole cgroup so no
# orphaned cutechess survives to race a restarted worker (P1.4).  The
# worker also terminates orphans recorded in worker_state during recovery.
[Unit]
Description=ChessArena worker
After=network.target

[Service]
Type=simple
User=chessarena
Group=chessarena
WorkingDirectory=/opt/chessarena/app/current
EnvironmentFile=/etc/chessarena/chessarena.env
ExecStart=/opt/chessarena/venv/bin/python -m chessarena.worker
Restart=always
RestartSec=5
MemoryMax=1700M
KillMode=mixed
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
